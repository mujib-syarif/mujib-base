# Cloudflare Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Image URLs carry ?v=<content hash> (from manifest.json), so they can be cached for a year.
/gallery/*
  Cache-Control: public, max-age=31536000, immutable
/free/*
  Cache-Control: public, max-age=31536000, immutable
/testimoni/*
  Cache-Control: public, max-age=31536000, immutable
# Manifests must always revalidate so new uploads show up immediately.
/gallery/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
/free/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
/testimoni/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
